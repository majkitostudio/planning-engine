# Ukázka konfigurace prostředí pro lokální vývoj.
#
# Zkopíruj tento soubor do `.env` a vyplň skutečné hodnoty.
# `.env` je ignorováno Gitem — sem nepatří žádné tajné údaje.
# Tento soubor (`.env.example`) je záměrně součástí repozitáře a neobsahuje
# skutečné přístupové údaje.

# Připojovací řetězec PostgreSQL (lokální vývoj).
DATABASE_URL="postgresql://user:password@localhost:5432/planning_engine?schema=public"
# Přímé připojení pro migrace, pokud se liší od DATABASE_URL (Neon: unpooled).
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Cloudflare Workers AI — zvolený měsíční AI plánovač.
# Account ID není tajné; API token ano. Nikdy je nevkládej do klienta ani logů.
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# Výchozí model; musí podporovat JSON Mode.
# CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# Pro reálný integrační test měsíčního AI návrhu nastav RUN_CLOUDFLARE_INTEGRATION="1".
# Test se bez něj přeskočí; nikdy neběží automaticky v CI.
# CLOUDFLARE_AI_TIMEOUT_MS="120000"
# Rozpočet na celý měsíc (všechny týdenní požadavky). Vercel Hobby dovoluje 300 s.
# CLOUDFLARE_AI_TOTAL_TIMEOUT_MS="270000"

# Google Gemini API — starší adaptér, mimo měsíční tok.
# Klíč se používá výhradně server-side; nikdy ho nevkládej do klienta ani logů.
GEMINI_API_KEY=""
# Výchozí model; lze přepnout na gemini-2.5-flash-lite apod.
GEMINI_MODEL="gemini-2.5-flash"
# Časový limit jednoho volání v milisekundách.
GEMINI_TIMEOUT_MS="30000"
# Volitelné přepsání základní URL (výchozí oficiální endpoint).
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"

# Plánovací provider. Bez hodnoty API běh odmítne; není tichý fallback.
PLANNING_PROVIDER="simulated"
# Volitelně přepíše provider pouze pro měsíční plán.
# Online (Vercel) použij "cloudflare"; "simulated" je jen ukázkový režim.
# PLANNING_MONTHLY_PROVIDER="cloudflare"

# Auth.js — lokální MVP login gate bez CRM.
# Heslo zůstává pouze v lokálním `.env.local`; do repozitáře ho nevkládej.
PLANNING_AUTH_MODE="local"
AUTH_SECRET=""
PLANNING_LOGIN_EMAIL="manager@example.local"
PLANNING_LOGIN_PASSWORD=""
PLANNING_LOGIN_ROLE="manager"

# Budoucí varianta autentizační brány — nyní se nepoužívá.
# PLANNING_AUTH_MODE="entra"
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# PLANNING_ALLOWED_EMAIL_DOMAIN="example.com"
# PLANNING_MANAGER_EMAILS=""

# Databázové účty (AppUser) — vyžaduje PLANNING_PERSISTENCE="prisma" a DATABASE_URL.
# PLANNING_AUTH_MODE="database"

# Uložení běhů a potvrzení. `prisma` je režim aplikace; `memory` pouze testovací režim.
PLANNING_PERSISTENCE="prisma"
