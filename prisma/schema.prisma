// Prisma schema — technický základ.
//
// Schema obsahuje seznam zaměstnanců pro plánování, provozní modely identity,
// snapshoty běhů, nastavení pilotu a rozhodnutí o syntetických požadavcích.
//
// Po schválení dodat modely sem. Soubor lze zformátovat příkazem
// `npm run db:generate` nevyžaduje běžící databázový server.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

enum AppUserRole {
  manager
  viewer
}

enum EmployeeRequestDecisionStatus {
  approved
  rejected
}

enum RosterHistorySource {
  copied_roster
  manual
}

enum RosterHistoryEntryStatus {
  shift
  off
}

model AppUser {
  id              String              @id @default(cuid())
  externalSubject String?             @unique
  email           String              @unique
  displayName     String
  role            AppUserRole         @default(viewer)
  active          Boolean             @default(true)
  passwordHash    String?
  mustChangePassword Boolean           @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  confirmedRuns   PlanningRunRecord[] @relation("PlanningRunConfirmedBy")
  confirmedMonthlyRuns MonthlyPlanningRun[] @relation("MonthlyPlanningRunConfirmedBy")
  auditEvents     AuditEvent[]
  employeeRequestDecisions EmployeeRequestDecision[]
  rosterHistoryImports RosterHistoryImport[]
}

model MonthlyPlanningRun {
  id            String   @id
  month         String
  providerName  String
  mode          String
  input         Json
  draft         Json
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   AppUser? @relation("MonthlyPlanningRunConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([month])
  @@index([confirmedById])
}

model PlanningEmployee {
  id          String   @id @default(cuid())
  displayName String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  rosterHistoryImports RosterHistoryImportEmployee[]
}

model RosterHistoryImport {
  id            String                  @id
  scopeKey      String
  fingerprint   String                  @unique
  version       Int
  periodStart   String
  periodEnd     String
  source        RosterHistorySource
  createdById   String
  createdBy     AppUser                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  employees     RosterHistoryImportEmployee[]
  createdAt     DateTime                @default(now())

  @@unique([scopeKey, version])
  @@index([periodStart, periodEnd])
  @@index([createdById, createdAt])
}

model RosterHistoryImportEmployee {
  importId   String
  employeeId String
  import     RosterHistoryImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  employee   PlanningEmployee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  entries    RosterHistoryEntry[]

  @@id([importId, employeeId])
  @@index([employeeId])
}

model RosterHistoryEntry {
  importId   String
  employeeId String
  date       String
  status     RosterHistoryEntryStatus
  startTime  String?
  endTime    String?
  importEmployee RosterHistoryImportEmployee @relation(fields: [importId, employeeId], references: [importId, employeeId], onDelete: Restrict)

  @@id([importId, employeeId, date])
  @@index([employeeId, date])
}

model EmployeeRequestDecision {
  id          String                           @id @default(cuid())
  requestId   String                           @unique
  status      EmployeeRequestDecisionStatus
  decidedAt   DateTime                         @default(now())
  decidedById String
  decidedBy   AppUser                          @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([decidedById, decidedAt])
}

model PlanningRunRecord {
  id             String       @id @default(cuid())
  proposalId     String       @unique
  scenarioId     String
  scenarioLabel  String
  providerName   String
  mode           String
  weekStart      String
  input          Json
  result         Json
  confirmedPlan  Json?
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    AppUser?     @relation("PlanningRunConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([weekStart])
  @@index([confirmedById])
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  actor      AppUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model StaffingRequirementSetting {
  id               String   @id @default(cuid())
  dayOfWeek        Int
  shiftKind        String
  requiredEmployees Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([dayOfWeek, shiftKind])
  @@index([dayOfWeek])
}
